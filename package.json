{
  "name": "deutschy",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/build-sw.mjs",
    "typecheck": "tsc --noEmit",
    "images": "node scripts/fetch-images.mjs",
    "verify": "node scripts/verify-content.mjs && node scripts/test-noun-photos.mjs",
    "qa:export": "node scripts/qa-export.mjs",
    "test:study": "node scripts/test-study.mjs && node scripts/test-review-commit.mjs",
    "test:pwa": "node scripts/test-pwa.mjs",
    "test:progress-bundle": "node scripts/test-progress-bundle.mjs",
    "test:speech": "node scripts/test-speech.mjs",
    "test:search:browser": "node scripts/test-search-browser.mjs",
    "test:dependencies": "node scripts/test-postcss.mjs",
    "test:navigation:browser": "node scripts/test-navigation-browser.mjs",
    "test:timed:browser": "node scripts/test-timed-browser.mjs",
    "test:planner:browser": "node scripts/test-planner-browser.mjs",
    "test:writing:browser": "node scripts/test-writing-browser.mjs",
    "test:verbs:browser": "node scripts/test-verbs-browser.mjs",
    "test:satzbau:browser": "node scripts/test-satzbau-browser.mjs",
    "test:voices:browser": "node scripts/test-voices-browser.mjs",
    "tts:manifest": "node scripts/build-tts-manifest.mjs",
    "test:tts": "node --experimental-sqlite scripts/test-tts-proxy.mjs",
    "test:audio:browser": "node scripts/test-audio-browser.mjs",
    "typecheck:worker": "tsc --noEmit --strict --skipLibCheck --target es2022 --module esnext --moduleResolution bundler --types @cloudflare/workers-types functions/lib/tts.ts",
    "test:conjugation:browser": "node scripts/test-conjugation-browser.mjs",
    "test:grammar-expansion:browser": "node scripts/test-grammar-expansion-browser.mjs",
    "test:everyday-verbs:browser": "node scripts/test-everyday-verbs-browser.mjs",
    "test:separable-conjugation:browser": "node scripts/test-separable-conjugation-browser.mjs",
    "test:photos:browser": "node scripts/test-photo-policy-browser.mjs",
    "test:completion:browser": "node scripts/test-completion-browser.mjs",
    "test:discovery:browser": "node scripts/test-word-discovery-browser.mjs",
    "test:noun-photos": "node scripts/test-noun-photos.mjs",
    "test:noun-photos:browser": "node scripts/test-noun-photos-browser.mjs",
    "test:review-commit": "node scripts/test-review-commit.mjs",
    "test:review-commit:browser": "node scripts/test-review-commit-browser.mjs"
  },
  "dependencies": {
    "hono": "^4.13.18",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261115.1",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.1",
    "postcss": "^8.5.33",
    "puppeteer-core": "^25.18.1",
    "tailwindcss": "^4.3.5",
    "typescript": "5.7"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  }
}
